---
import '../styles/global.css';
import shows from '../content/shows.json';

const allImages = import.meta.glob('/public/images/archive/*.{jpg,jpeg,png,webp}', { 
  eager: true,
  query: '?url' 
});

const archive = Object.values(allImages).map((img: any) => {
  // Wir stellen sicher, dass der Pfad für den Browser sauber ist
  return img.default.replace('/public', '');
});

const bandName = "TUBE";
// YouTube entfernt, nur noch Instagram und Spotify
const socialLinks = [
  { name: "INSTAGRAM", url: "https://instagram.com/tubeofficial22" },
  { name: "SPOTIFY", url: "https://open.spotify.com/intl-de/artist/0zHfXqVADB6QEcKwb49wOB?si=Kmyk_DwiQQe_HlWkFK4HsA" }
];
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{bandName}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="grain"></div>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-nav">
         <img src="/images/kiffi/kiffi_logo_white.png" alt="Kiffi Logo" style="height: 50px; width: auto; opacity: 0.9;" />
         <span>GERMANY / 2026</span>
        </div>
        
        <h1>{bandName}</h1>
        
        <!-- SOCIALS DIREKT UNTER DEM TITEL -->
        <div class="hero-socials">
          {socialLinks.map((link, index) => (
            <>
              <a href={link.url} target="_blank">{link.name}</a>
              {index < socialLinks.length - 1 && <span class="separator">/</span>}
            </>
          ))}
        </div>
      </section>

      <!-- SHOWS -->
      <section id="shows" class="content-section">
        <h2 class="section-title">UPCOMING SHOWS</h2>
        <div class="show-container">
          {shows.map((show) => (
            <div class="show-row">
              <div class="show-main">
                <span class="show-date">{show.date}</span>
                <span class="show-location">
                  <span class="show-city">{show.city}</span>
                  <span class="show-venue">{show.venue}</span>
                </span>
              </div>
              <a href={show.link} target="_blank" class="ticket-button">MORE</a>
            </div>
          ))}
        </div>
      </section>
      //merch
      <section id="merch" class="content-section">
  <h2 class="section-title">MERCH</h2>
  <div class="merch-grid">
    <div class="merch-item">
      <div class="merch-img-container">
         <img src="/images/merch/shirt.jpg" alt="Tube Shirt" />
      </div>
      <h3>SHIRT "CLASSIC"</h3>
      <p>Bestellung via Mail</p>
    </div>
    <div class="merch-item">
      <div class="merch-img-container">
         <img src="/images/merch/lighter.jpg" alt="Tube Feuerzeug" />
      </div>
      <h3>FEUERZEUG</h3>
      <p>Bestellung via Mail</p>
    </div>
  </div>
</section>
      <!-- ARCHIVE -->
      <section id="archive" class="content-section">
        <h2 class="section-title">ARCHIVE</h2>
        <div class="media-grid">
          {archive.map((imgUrl) => (
            <div class="media-item">
              <img src={imgUrl} alt="Tube Foto" loading="lazy" />
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- FOOTER -->
  <footer>
  <div class="footer-content">
    <img src="/images/kiffi/kiffi_logo_white.png" alt="Logo" style="height: 40px; opacity: 0.4; margin-bottom: 1rem;" />
    <h2>{bandName}</h2>
    <a href="mailto:tubeband.business@gmail.com" style="color: var(--accent); text-decoration: none; font-family: monospace;">
      tubeband.business@gmail.com
    </a>
    <p class="copyright" style="margin-top: 3rem; opacity: 0.2;">© 2026 TUBE. DESIGNED FOR THE LOUD.</p>
  </div>
</footer>

    <!-- LIGHTBOX -->
    <div id="lightbox" class="lightbox">
      <span class="close">&times;</span>
      <img class="lightbox-content" id="lightbox-img">
    </div>

  </body>
</html>

<style>
 :root {
  --accent: #ff3e00;
  --bg: #000000; /* Hier auf echtes Schwarz setzen */
  --text: #ffffff;
}

body {
  background-color: var(--bg); /* Stellt sicher, dass er die Variable nutzt */
  color: var(--text);
  font-family: 'Inter', sans-serif;
    margin: 0;
}



  .grain {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: url('https://grainy-gradients.vercel.app/noise.svg');
    opacity: 0.04; pointer-events: none; z-index: 50;
  }

  /* Hero Section */
  .hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero-nav {
    position: absolute; top: 2rem; width: 100%;
    display: flex; justify-content: flex-end; /* Standort nach rechts */
    padding: 0 3rem; font-family: monospace; font-size: 0.75rem;
    opacity: 0.5;
  }

  h1 {
    font-size: clamp(5rem, 25vw, 15rem);
    font-weight: 900; margin: 0; line-height: 0.8;
    letter-spacing: -0.05em;
  }

  /* Socials unter dem Titel */
  .hero-socials {
    margin-top: 2rem;
    font-family: monospace;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .hero-socials a {
    color: white;
    text-decoration: none;
    transition: color 0.3s;
  }

  .hero-socials a:hover {
    color: var(--accent);
  }

  .separator {
    margin: 0 1rem;
    opacity: 0.3;
  }

  /* Restliches Styling wie vorher (Shows, Archive, Footer...) */
  .content-section { padding: 8rem 2rem; max-width: 1200px; margin: 0 auto; }
  .section-title { font-size: 0.8rem; font-family: monospace; letter-spacing: 0.3rem; margin-bottom: 4rem; color: var(--accent); text-transform: uppercase; }
  .show-container { border-top: 1px solid #222; }
  .show-row { display: flex; justify-content: space-between; align-items: center; padding: 2.5rem 0; border-bottom: 1px solid #222; transition: all 0.4s ease; }
  .show-row:hover { background: #0f0f0f; padding-left: 1rem; padding-right: 1rem; }
  .show-main { display: flex; align-items: baseline; gap: 3rem; }
  .show-date { font-family: monospace; font-size: 1.2rem; opacity: 0.5; }
  .show-location { display: flex; flex-direction: column; }
  .show-city { font-size: 2rem; font-weight: 900; text-transform: uppercase; }
  .show-venue { font-size: 0.9rem; opacity: 0.4; text-transform: uppercase; }
  .ticket-button { text-decoration: none; color: white; border: 1px solid #444; padding: 0.8rem 2rem; border-radius: 50px; font-size: 0.8rem; font-weight: bold; transition: all 0.3s; }
  .ticket-button:hover { background: white; color: black; border-color: white; }
  .media-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (min-width: 768px) { .media-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }
  .media-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    /* Filter entfernt - Bilder sind jetzt immer farbig */
    filter: none; 
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
    cursor: pointer;
    border-radius: 2px; /* Ganz leicht abgerundet wirkt wertiger */
  }

  .media-item:hover img {
    transform: scale(1.05);
    z-index: 10;
  }
  .media-item:hover img { filter: grayscale(0%); transform: scale(1.03); }
  footer { padding: 10rem 2rem 5rem; text-align: center; background: #000; }
  .footer-content h2 { font-size: 4rem; margin-bottom: 2rem; letter-spacing: -2px; }
  .social-links-bottom { margin-bottom: 3rem; }
  .social-links-bottom a { color: white; text-decoration: none; font-family: monospace; margin: 0 1rem; font-size: 1rem; opacity: 0.6; transition: 0.3s; }
  .social-links-bottom a:hover { opacity: 1; color: var(--accent); }
  .copyright { font-size: 0.6rem; opacity: 0.2; letter-spacing: 2px; }
  .lightbox { display: none; position: fixed; z-index: 1000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.98); justify-content: center; align-items: center; }
  .lightbox-content { max-width: 90%; max-height: 85%; object-fit: contain; }
  .close { position: absolute; top: 20px; right: 30px; font-size: 40px; cursor: pointer; }

  @media (max-width: 768px) {
    .show-main { flex-direction: column; gap: 0.5rem; }
    .show-city { font-size: 1.5rem; }
    .hero-nav { padding: 1rem 2rem; }
    .ticket-button { padding: 0.5rem 1rem; }
  }
</style>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    if (!lightbox || !lightboxImg) return;
    document.querySelectorAll('.media-item img').forEach(image => {
      image.addEventListener('click', () => {
        const src = image.getAttribute('src');
        if (src) {
          lightbox.style.display = 'flex';
          lightboxImg.src = src;
        }
      });
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target !== lightboxImg) {
        lightbox.style.display = 'none';
      }
    });
  }
  document.addEventListener('DOMContentLoaded', initLightbox);
</script>